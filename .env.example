# Alexa Configuration
ALEXA_SKILL_ID=amzn1.ask.skill.xxxxx-xxxxx-xxxxx
ALEXA_ENDPOINT=https://your-api.example.com/alexa/intent

# Claude API
CLAUDE_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLAUDE_MODEL=claude-3-5-sonnet
CLAUDE_MAX_TOKENS=1024

# Server
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# Security
ALLOWED_ORIGINS=http://localhost:3000,https://alexa-app.example.com
CORS_CREDENTIALS=true
HELMET_ENABLED=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=10

# Logging (tamanho máximo dos arquivos de log antes de sobrescrever)
MAX_LOG_SIZE=5242880                    # 5MB para combined.log
MAX_ERROR_LOG_SIZE=2097152              # 2MB para error.log

# Database (opcional)
DB_URL=postgresql://user:pass@host:5432/alexa_db
